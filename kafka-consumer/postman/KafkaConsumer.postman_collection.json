							"key": "Content-Type",
							"value": "application/json"
						}
					],
					"body": "{\n    \"status\": \"success\",\n    \"message\": \"Successfully reset offset for topic=my-topic, partition=0 to offset=100\"\n}"
				}
			]
		},
