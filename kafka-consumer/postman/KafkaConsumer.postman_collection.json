			"name": "Reset Kafka Consumer Offset",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"topic\": \"my-topic\",\n    \"partition\": 0,\n    \"offset\": 100\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/kafka/offset/reset",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"kafka",
						"offset",
						"reset"
					]
				},
				"description": "Reset the offset for a specific topic and partition"
			},
			"response": [
