{
	"info": {
		"_postman_id": "kafka-consumer-collection",
		"name": "Kafka Consumer API",
		"description": "Collection for Kafka Consumer API endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Consumer Control",
			"item": [
				{
					"name": "Get Kafka Listener IDs",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/kafka/consumer/listeners",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"kafka",
								"consumer",
								"listeners"
							]
						},
						"description": "Get list of all Kafka listener IDs"
					}
				},
				{
					"name": "Pause All Consumers",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/kafka/consumer/pause/all",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"kafka",
								"consumer",
								"pause",
								"all"
							]
						},
						"description": "Pause all Kafka consumers. Returns status for each consumer. Metrics will continue to be reported."
					}
				},
				{
					"name": "Resume All Consumers",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/kafka/consumer/resume/all",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"kafka",
								"consumer",
								"resume",
								"all"
							]
						},
						"description": "Resume all paused Kafka consumers. Returns status for each consumer."
					}
				},
				{
					"name": "Pause Kafka Consumer",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/kafka/consumer/pause?listenerId=your-listener-id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"kafka",
								"consumer",
								"pause"
							],
							"query": [
								{
									"key": "listenerId",
									"value": "your-listener-id",
									"description": "The ID of the Kafka listener to pause"
								}
							]
						},
						"description": "Pause a specific Kafka consumer by its listener ID (metrics will continue to be reported)"
					}
				},
				{
					"name": "Resume Kafka Consumer",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/kafka/consumer/resume?listenerId=your-listener-id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"kafka",
								"consumer",
								"resume"
							],
							"query": [
								{
									"key": "listenerId",
									"value": "your-listener-id",
									"description": "The ID of the Kafka listener to resume"
								}
							]
						},
						"description": "Resume a paused Kafka consumer by its listener ID"
					}
				}
			]
		},
		{
			"name": "Metrics",
			"item": [
				{
					"name": "Get All Metrics",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/metrics",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"actuator",
								"metrics"
							]
						},
						"description": "List all available metrics"
					}
				},
				{
					"name": "Get Custom Consumer Lag Metric",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/metrics/custom.kafka.consumer.lag",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"actuator",
								"metrics",
								"custom.kafka.consumer.lag"
							]
						},
						"description": "Get the custom consumer lag metric derived from records-lag-max. Includes tags: consumer_group, application, metric_type"
					}
				},
				{
					"name": "Get Records Lag Max Metric",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/metrics/kafka.consumer.fetch.manager.records.lag.max",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"actuator",
								"metrics",
								"kafka.consumer.fetch.manager.records.lag.max"
							]
						},
						"description": "Get the maximum records lag metric across all partitions. Includes tags: consumer_group, metric_type"
					}
				},
				{
					"name": "Get Total Lag Metric",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/metrics/kafka.consumer.totalLag",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"actuator",
								"metrics",
								"kafka.consumer.totalLag"
							]
						},
						"description": "Get the total consumer lag metric. Includes tag: consumerGroupId"
					}
				}
			]
		},
		{
			"name": "Health and Info",
			"item": [
				{
					"name": "Get Health Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"actuator",
								"health"
							]
						},
						"description": "Get application health status"
					}
				},
				{
					"name": "Get Application Info",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/info",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"actuator",
								"info"
							]
						},
						"description": "Get application information"
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081",
			"type": "string"
		}
	]
} 